<UserControl x:Class="AirPodsWin.BatteryRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="86">
    <StackPanel HorizontalAlignment="Center">
        <Grid Width="68" Height="68">
            <Ellipse Margin="2.5" Stroke="#33FFFFFF" StrokeThickness="5"/>
            <Path x:Name="Arc" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Image x:Name="Pic" Width="54" Height="54" Stretch="Uniform" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Viewbox Width="26" Height="26" RenderTransformOrigin="0.5,0.5" x:Name="IconBox">
                <Path x:Name="Icon" Fill="White"/>
            </Viewbox>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock x:Name="PercentText" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock x:Name="Bolt" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="12" Foreground="#30D158" Margin="3,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="TitleText" FontSize="11" Foreground="#A0FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0"/>
    </StackPanel>
</UserControl>
